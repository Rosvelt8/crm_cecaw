# Application
NODE_ENV=development
PORT=4000

# Database
POSTGRES_DB=cecaw_crm
POSTGRES_USER=cecaw
POSTGRES_PASSWORD=cecaw_secret
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cecaw:cecaw_secret@localhost:5432/cecaw_crm

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_me_in_production_very_long_secret_at_least_64_chars
JWT_REFRESH_SECRET=change_me_refresh_very_long_secret_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App settings
DEFAULT_PASSWORD=Cecaw2025!
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Frontend (pour CORS + liens dans les emails)
FRONTEND_URL=https://crm.cecaw.cm

# SMTP (laisser SMTP_HOST vide pour désactiver les emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@cecaw.cm
SMTP_PASS=votre_mot_de_passe_app
SMTP_FROM=CECAW CRM <noreply@cecaw.cm>

# Sécurité des données (obligatoire en production)
# 64 caractères hexadécimaux : openssl rand -hex 32. À conserver HORS du serveur (voir docs/RUNBOOK_REPRISE.md)
DATA_ENCRYPTION_KEY=
TRUST_PROXY=false

# Sauvegardes (JOBS_ENABLED=false désactive les tâches planifiées)
BACKUP_DIR=./backups
BACKUP_ENABLED=true
BACKUP_ENCRYPT=true
# PG_DUMP_PATH=
# PG_RESTORE_PATH=
JOBS_ENABLED=true

# SMS (passerelle HTTP JSON générique ; vide = messages laissés en échec)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=CECAW

# WhatsApp (API Cloud Meta ; vide = canal indisponible même si activé depuis l'administration)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_URL=https://graph.facebook.com/v21.0

# Export comptable (optionnel)
COMPTA_EXPORT_URL=
COMPTA_EXPORT_KEY=
